# Optional. Raises the GitHub API ceiling for the live radar and the repository
# tree metrics from 60 requests/hour per IP to 5,000/hour. Vercel functions share
# egress IPs, so the unauthenticated limit is reachable in ordinary traffic;
# without a token the site falls back to the mined snapshot in
# data/project-intelligence.json and labels itself "research-snapshot".
# Needs no scopes - public read only.
GITHUB_TOKEN=

# ADMIN_PASSCODE, VITE_ADMIN_PASSCODE, BLOB_STORE_ID, BLOB_READ_WRITE_TOKEN and
# BLOB_WEBHOOK_PUBLIC_KEY were documented here but are read nowhere in app/,
# components/, lib/, scripts/ or data/. Removed rather than left standing as an
# instruction to provision secrets nothing consumes.
